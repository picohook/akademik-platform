# Copy to .env and change every value before deploying.
# The web service connects as the non-owner role created in db/schema.sql:
#   akademik_app / akademik_app_dev  (scaffold only; rotate before deployment)
POSTGRES_DB=akademik
POSTGRES_USER=akademik
POSTGRES_PASSWORD=change-me-in-production

DEMO_TENANT_ID=11111111-1111-1111-1111-111111111111
DEMO_USER_ID=22222222-2222-2222-2222-222222222222
SESSION_SECRET=change-me-to-a-long-random-string
# Demo login (seed.sql); change before any shared deployment.
DEMO_EMAIL=reader@example.edu.tr
DEMO_PASSWORD=demo1234

# Reader-side SSO (docs/contracts/libedge-elibrary-v1.md, section 2).
# The public halves of the Worker's handoff signing keys, at most two (rotation overlap).
#   LIBEDGE_SSO_PUBLIC_KEYS=[{"kid":"2026-11","kty":"OKP","crv":"Ed25519","x":"..."}]
# Unset means SSO is disabled: /auth/libedge/callback answers 503. NEVER put the key from
# docs/contracts/vectors/ed25519-test-keys.json here for a real deployment - that private
# key is in the repository, and the server refuses to start with it under NODE_ENV=production.
# LIBEDGE_SSO_ISSUER=libedge
# LIBEDGE_SSO_AUDIENCE=elibrary.libedge.com
# LIBEDGE_SSO_HANDOFF_URL=https://libedge.com/elibrary/handoff
# Session length in hours, 1-72 (contract 10/6: default 12).
# LIBEDGE_SSO_SESSION_HOURS=12

# Local (without Docker):
# DATABASE_URL=postgres://akademik_app:akademik_app_dev@localhost:5432/akademik
# PORT=3000
