# Copy to .env.production and replace every value before a pilot.
DOMAIN=books.example.edu.tr

POSTGRES_DB=akademik
POSTGRES_USER=akademik
POSTGRES_PASSWORD=replace-with-a-long-random-secret

# The app role is created by db/schema.sql with a scaffold password.
# After first boot, rotate it (see docs/PILOT.md) and update this URL.
DATABASE_URL=postgres://akademik_app:akademik_app_dev@db:5432/akademik

SESSION_SECRET=replace-with-at-least-32-random-bytes
BRAND_NAME=Kurum Kütüphanesi
BRAND_TAGLINE=akademik e-kitap

DEMO_TENANT_ID=11111111-1111-1111-1111-111111111111
DEMO_USER_ID=22222222-2222-2222-2222-222222222222
