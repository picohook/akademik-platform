[Unit]
Description=LibRead (Oracle production) encrypted backup
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
# Plain KEY=value file read by systemd (not a shell). Holds the age PUBLIC key and the
# backup-only R2 credential. Mode 0600. See docs/runbooks/oracle-backup-restore.md.
EnvironmentFile=/home/ubuntu/libedge-oracle-v137/config/backup/backup.env
ExecStart=/usr/local/lib/libread-backup/backup-oracle.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h
