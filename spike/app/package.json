{
  "name": "akademik-spike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Spike harness for the academic e-book platform (PDF.js + Postgres FTS + anchor model)",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test:citations": "node test/citations.test.mjs",
    "test:search": "node test/search.test.mjs",
    "test:security": "node test/security.integration.mjs",
    "test:security-headers": "node test/security-headers.test.mjs",
    "test:tenant-access": "node test/tenant-access.integration.mjs",
    "test:watermarks": "node test/social-watermark.test.mjs",
    "test:social-drm": "node test/social-drm.integration.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "busboy": "^1.6.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.296",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "epubjs": "^0.3.93"
  }
}
